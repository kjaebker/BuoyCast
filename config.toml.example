[server]
host = "0.0.0.0"
port = 8080
mdns_name = "buoycast"         # accessible at buoycast.local
# IP addresses, *.local and single-label names always work. List any other
# host name you open the dashboard by (e.g. a reverse proxy's domain).
allowed_hosts = []

[s4]
port = "/dev/ttyACM0"          # USB serial port for WaterRower S4
baud_rate = 19200
poll_interval_hz = 1.0
reconnect_delay_s = 5

[heart_rate]
enabled = true
device_mac = ""                # Wahoo TICKR MAC (e.g. "A4:34:F1:XX:XX:XX")
device_name = ""               # e.g. "TICKR XXXX"
required = false               # workout proceeds without HR if strap unavailable
debug_capture = false          # write raw BLE HR data to JSONL file for analysis
debug_capture_dir = "data/hr_debug"

[workout]
auto_pause_idle_s = 30         # pause after 30s no strokes
auto_end_idle_s = 300          # prompt to end after 5min idle
min_workout_distance_m = 100   # discard workouts under 100m

[strava]
client_id = ""                 # from your Strava API app
client_secret = ""

[export]
# Send each finished workout to your own HTTP endpoint (see docs/export.md).
url = ""                       # e.g. "https://example.com/ingest/buoycast"; "" = off
token = ""                     # sent as "Authorization: Bearer <token>"; "" = no header
format = "json"                # "json" (summary + per-second samples) or "fit"
auto_send = true               # false = only send from the workout history screen
include_hr = true
retry_interval_s = 300         # how often failed sends are retried

[storage]
db_path = "data/buoycast.db"
fit_dir = "data/fit"

[logging]
level = "INFO"                 # DEBUG | INFO | WARNING | ERROR
log_dir = "logs"               # rotating log files written here; "" to disable
json_logs = false              # true = one JSON object per line (for log aggregators)
