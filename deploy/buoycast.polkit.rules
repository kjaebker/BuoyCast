// Installed to /etc/polkit-1/rules.d/50-buoycast.rules by install.sh.
//
// Lets the unprivileged `buoycast` service user do exactly three things from
// the dashboard: restart its own service, start the updater, and reboot.
polkit.addRule(function (action, subject) {
    if (subject.user !== "buoycast") {
        return polkit.Result.NOT_HANDLED;
    }

    if (action.id === "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if (unit === "buoycast.service" && verb === "restart") {
            return polkit.Result.YES;
        }
        if (unit === "buoycast-update.service" && verb === "start") {
            return polkit.Result.YES;
        }
    }

    if (action.id === "org.freedesktop.login1.reboot" ||
        action.id === "org.freedesktop.login1.reboot-multiple-sessions") {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});
