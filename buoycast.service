[Unit]
Description=BuoyCast — WaterRower S4 Bridge
Documentation=https://github.com/your-org/BuoyCast
After=network.target bluetooth.target bluetooth.service hciuart.service
Wants=avahi-daemon.service bluetooth.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/buoycast
ExecStartPre=+/usr/sbin/rfkill unblock bluetooth
ExecStartPre=+/usr/bin/bluetoothctl power on
ExecStart=/opt/buoycast/.venv/bin/python -m src.main
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# Hardware access
SupplementaryGroups=dialout bluetooth

# Resource limits for Pi Zero 2W
MemoryMax=200M
CPUQuota=80%

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/buoycast/data
ProtectHome=true

[Install]
WantedBy=multi-user.target
